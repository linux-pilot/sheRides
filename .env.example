# Copy to .env and set a long random JWT_SECRET (e.g. `openssl rand -hex 32`).
MONGO_URL=mongodb://mongo:27017/sherides
JWT_SECRET=change-me
# Leave empty: the site reaches the API through its own /api path. Set only for a separately hosted API.
VITE_API_URL=
# Your Mac's Wi-Fi address, for the phone-testing HTTPS address https://<LAN_IP>:3443
LAN_IP=
# Only needed when VITE_API_URL points at another host (comma-separated list of site addresses).
CLIENT_ORIGIN=http://localhost:3000
# Email (SMTP). Default: Mailpit container, inbox at http://localhost:8025.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password> MAIL_FROM=SheRides Safety <you@gmail.com>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SheRides Safety <safety@sherides.test>
