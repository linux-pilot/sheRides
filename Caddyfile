# HTTPS front door for testing on a phone over Wi-Fi (browsers only share location with https pages).
# https://<LAN_IP>:3443 → the Vite dev server, which also forwards /api and the WebSocket to the API.
# Caddy's own local CA signs a one-year certificate for LAN_IP (kept in the caddy_data volume): accept the
# warning once on the phone. ponytail: self-signed, LAN only. Upgrade: real domain + Let's Encrypt.
{
	skip_install_trust
	# Phones opening an IP address send no SNI; answer them with the LAN_IP certificate.
	default_sni {$LAN_IP}
	pki {
		ca local {
			intermediate_lifetime 730d
		}
	}
}

https://{$LAN_IP}:3443, https://localhost:3443 {
	tls {
		issuer internal {
			lifetime 365d
		}
	}
	reverse_proxy client:3000
}
